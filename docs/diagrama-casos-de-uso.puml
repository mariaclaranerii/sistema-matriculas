@startuml
title Diagrama de Casos de Uso - Sistema de Matrículas

left to right direction

skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "DejaVu Sans"
skinparam ArrowColor #374151
skinparam ActorBorderColor #374151
skinparam ActorFontColor #111827
skinparam UsecaseBorderColor #374151
skinparam UsecaseBackgroundColor white
skinparam UsecaseFontColor #111827
skinparam RectangleBorderColor #6B7280
skinparam RectangleFontColor #111827
skinparam NoteBorderColor #9CA3AF
skinparam NoteBackgroundColor #F9FAFB

actor Aluno as ALU
actor Professor as PRO
actor Secretaria as SEC
actor "Sistema de Cobranças" as COB <<sistema externo>>

rectangle "Sistema de Matrículas" {
  usecase "Validar login" as LOGIN
  usecase "Gerar currículo\ndo semestre" as CURRICULO
  usecase "Manter informações de\ndisciplinas, professores e alunos" as MANTER
  usecase "Realizar matrícula\nem disciplinas" as MATRICULA
  usecase "Cancelar matrícula" as CANCELAR
  usecase "Consultar alunos matriculados\npor disciplina" as CONSULTAR
  usecase "Notificar Sistema\nde Cobranças" as NOTIFICAR
}

ALU -- LOGIN
ALU -- MATRICULA
ALU -- CANCELAR

PRO -- LOGIN
PRO -- CONSULTAR

SEC -- LOGIN
SEC -- CURRICULO
SEC -- MANTER

MATRICULA ..> NOTIFICAR : <<include>>
COB -- NOTIFICAR

note bottom of CURRICULO
  Cada curso possui nome, número de créditos
  e é constituído por diversas disciplinas.
end note

note bottom of MATRICULA
  4 disciplinas como primeira opção e
  2 alternativas.
  Máximo de 60 alunos por disciplina.
  Ao final do período, a disciplina com pelo menos
  3 matriculados fica ativa; caso contrário, é cancelada.
end note

@enduml
