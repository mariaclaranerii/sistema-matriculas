@startuml
title Sistema de Matrículas - Diagrama de Classes

top to bottom direction
!pragma layout smetana

skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam classAttributeIconSize 0
skinparam ArrowColor #374151
skinparam ClassBorderColor #1D4ED8
skinparam ClassBackgroundColor #EFF6FF
skinparam ClassFontColor #111827
skinparam InterfaceBorderColor #B45309
skinparam InterfaceBackgroundColor #FFFBEB
skinparam EnumBorderColor #047857
skinparam EnumBackgroundColor #ECFDF5
skinparam NoteBorderColor #6B7280
skinparam NoteBackgroundColor #F9FAFB

package "Interface" {
  class Main {
    {static} + main(args: String[]): void
  }

  class InterfaceConsole {
    + executar(): void
  }
}

package "Acesso e usuários" {
  abstract class Usuario {
    - login: String
    - senha: String
    + validarSenha(senhaInformada: String): boolean
    + getLogin(): String
    + getPapel(): String
  }

  class Aluno
  class Professor
  class Secretaria

  Usuario <|-- Aluno
  Usuario <|-- Professor
  Usuario <|-- Secretaria
}

package "Aplicação" {
  class SistemaMatriculas <<control>> {
    - estado: EstadoSistema
    - sistemaCobrancas: SistemaCobrancas
    + autenticar(login: String, senha: String): Usuario
    + gerarCurriculo(identificador: String, cursos: List<Curso>): CurriculoSemestral
    + manterDisciplina(disciplina: Disciplina): void
    + manterProfessor(professor: Professor): void
    + manterAluno(aluno: Aluno): void
    + realizarMatricula(aluno: Aluno, curriculo: CurriculoSemestral,
      primeiras: List<OfertaDisciplina>, alternativas: List<OfertaDisciplina>): MatriculaSemestral
    + cancelarMatricula(matricula: MatriculaDisciplina): void
    + processarEncerramento(curriculo: CurriculoSemestral): void
    + consultarAlunos(oferta: OfertaDisciplina): List<Aluno>
  }

  class DadosIniciais {
    {static} + inicializar(estado: EstadoSistema, sistema: SistemaMatriculas): void
  }
}

package "Domínio acadêmico" {
  class Curso {
    - nome: String
    - numeroCreditos: int
    - disciplinas: List<Disciplina>
    + adicionarDisciplina(disciplina: Disciplina): void
  }

  class Disciplina {
    - nome: String
  }

  class CurriculoSemestral {
    - identificadorSemestre: String
    - cursos: List<Curso>
    - periodoMatricula: PeriodoMatricula
    - ofertas: List<OfertaDisciplina>
    + adicionarOferta(disciplina: Disciplina): OfertaDisciplina
    + listarOfertas(): List<OfertaDisciplina>
  }

  class PeriodoMatricula {
    - status: StatusPeriodo
    + estaEmAndamento(): boolean
    + encerrar(): void
  }

  class OfertaDisciplina {
    {static} + MINIMO_ALUNOS: int = 3
    {static} + MAXIMO_ALUNOS: int = 60
    - disciplina: Disciplina
    - situacao: SituacaoOferta
    - inscricoesAbertas: boolean
    - matriculas: List<MatriculaDisciplina>
    + quantidadeMatriculados(): int
    + podeReceberMatricula(): boolean
    + registrarMatricula(matricula: MatriculaDisciplina): void
    + cancelarMatricula(matricula: MatriculaDisciplina): void
    + processarResultado(): void
  }

  enum StatusPeriodo {
    EM_ANDAMENTO
    ENCERRADO
  }

  enum SituacaoOferta {
    PENDENTE
    ATIVA
    CANCELADA
  }
}

package "Domínio de matrícula" {
  class MatriculaSemestral {
    - aluno: Aluno
    - curriculo: CurriculoSemestral
    - confirmada: boolean
    - matriculas: List<MatriculaDisciplina>
    + adicionarDisciplina(oferta: OfertaDisciplina, tipo: TipoOpcao): MatriculaDisciplina
    + validarLimites(): boolean
    + confirmar(): void
  }

  class MatriculaDisciplina {
    - oferta: OfertaDisciplina
    - tipoOpcao: TipoOpcao
    - status: StatusMatricula
    + cancelar(): void
  }

  enum TipoOpcao {
    PRIMEIRA_OPCAO
    ALTERNATIVA
  }

  enum StatusMatricula {
    ATIVA
    CANCELADA
  }
}

package "Persistência" {
  class EstadoSistema {
    - usuarios: List<Usuario>
    - disciplinas: List<Disciplina>
    - cursos: List<Curso>
    - curriculos: List<CurriculoSemestral>
    - matriculas: List<MatriculaSemestral>
    + adicionarUsuario(usuario: Usuario): void
    + adicionarCurriculo(curriculo: CurriculoSemestral): void
    + adicionarMatricula(matricula: MatriculaSemestral): void
  }

  class PersistenciaArquivo {
    - arquivo: Path
    + carregar(): EstadoSistema
    + salvar(estado: EstadoSistema): void
  }
}

package "Integração externa" {
  interface SistemaCobrancas <<sistema externo>> {
    + notificarInscricao(matricula: MatriculaSemestral): void
  }

  class SistemaCobrancasArquivo {
    - arquivo: Path
    + notificarInscricao(matricula: MatriculaSemestral): void
  }

  SistemaCobrancas <|.. SistemaCobrancasArquivo
}

Main ..> InterfaceConsole
Main ..> SistemaMatriculas
Main ..> PersistenciaArquivo
InterfaceConsole --> SistemaMatriculas
InterfaceConsole --> PersistenciaArquivo
DadosIniciais ..> EstadoSistema
DadosIniciais ..> SistemaMatriculas

SistemaMatriculas --> EstadoSistema
SistemaMatriculas ..> Usuario : autentica
SistemaMatriculas ..> SistemaCobrancas : notifica
PersistenciaArquivo --> EstadoSistema : carrega/salva

Curso "0..*" -- "1..*" Disciplina : é constituído por
CurriculoSemestral "1" o-- "1..*" Curso : inclui
CurriculoSemestral "1" *-- "1" PeriodoMatricula
CurriculoSemestral "1" *-- "1..*" OfertaDisciplina
OfertaDisciplina "0..*" --> "1" Disciplina : refere-se a

Aluno "1" -- "0..*" MatriculaSemestral
MatriculaSemestral "0..*" --> "1" CurriculoSemestral
MatriculaSemestral "1" *-- "1..6" MatriculaDisciplina
MatriculaDisciplina "0..*" --> "1" OfertaDisciplina

EstadoSistema "1" *-- "0..*" Usuario
EstadoSistema "1" *-- "0..*" Disciplina
EstadoSistema "1" *-- "0..*" Curso
EstadoSistema "1" *-- "0..*" CurriculoSemestral
EstadoSistema "1" *-- "0..*" MatriculaSemestral

note bottom of OfertaDisciplina
  Regras do enunciado:
  - máximo de 60 alunos por oferta;
  - 3 ou mais alunos tornam a oferta ativa;
  - menos de 3 alunos cancelam a oferta.
end note

note bottom of MatriculaSemestral
  Regras do enunciado:
  - até 4 disciplinas de primeira opção;
  - até 2 disciplinas alternativas;
  - matrícula e cancelamento apenas no período.
end note

legend bottom
  |= Premissa de modelagem |= Justificativa |
  | **PM-DC01** | `identificadorSemestre` é o dado mínimo para distinguir currículos. |
  | **PM-DC02** | `OfertaDisciplina` separa o cadastro da ocorrência semestral. |
  | **PM-DC03** | `MatriculaSemestral` agrupa as escolhas para notificação à cobrança. |
  | **PM-DC04** | Não há associação Professor-Disciplina; ela não consta no enunciado. |
  | **PM-DC05** | `nome` identifica a Disciplina na interface e na persistência. |
  | **PM-DC06** | O processamento solicitado encerra o período e classifica as ofertas. |
  |= Convenção visual |= Detalhe |
  | Acessores, construtores e métodos auxiliares foram omitidos para legibilidade. ||
endlegend

@enduml
